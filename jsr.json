  "imports": {
    "@simplewebauthn/server": "npm:@simplewebauthn/server@^14.0.3",
    "@udibo/http-error": "jsr:@udibo/http-error@^0.12.0"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "README.md",
      "LICENSE",
      "SECURITY.md",
      "CONTRIBUTING.md",
      "llms.txt",
      "llms-full.txt",
