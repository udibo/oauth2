    "./server/resource": "./src/server/resource-server.ts",
    "./server/public-suffix": "./src/server/public-suffix/mod.ts",
    "./client": "./src/client/mod.ts",
    "./identity": "./src/identity/mod.ts",
    "./identity/external": "./src/identity/external/mod.ts",
    "./identity/mfa": "./src/identity/mfa/mod.ts",
    "./identity/passkeys": "./src/identity/passkeys/mod.ts",
    "./identity/migration": "./src/identity/migration.ts",
    "./hono/resource-server": "./src/adapters/hono/resource-server.ts",
    "./hono/authorization-server": "./src/adapters/hono/authorization-server.ts",
    "./hono/bff": "./src/adapters/hono/bff/mod.ts",
    "./hono/bff/testing": "./src/adapters/hono/bff/testing.ts",
    "./hono/identity": "./src/adapters/hono/identity.ts",
    "./hono/log": "./src/adapters/hono/log.ts",
    "./express/resource-server": "./src/adapters/express/resource-server.ts",
    "./express/authorization-server": "./src/adapters/express/authorization-server.ts",
    "./react": "./src/react/mod.ts",
    "./react/components": "./src/react/components/mod.ts",
    "./react/testing": "./src/react/testing.tsx",
    "./testing": "./src/testing/mod.ts",
    "./testing/contract": "./src/testing/contract/mod.ts",
    "./crypto": "./src/utils/crypto.ts",
    "./url": "./src/utils/url.ts"
