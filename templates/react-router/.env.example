# Copy to .env — `pnpm dev` and `pnpm start` load it with `--env-file-if-exists`.
# Every value has a default, so the app also runs with no .env at all.

# Public origin the app is served from. The OAuth2 issuer, redirect URIs, and
# emailed links all derive from it. Cookies turn Secure automatically when it
# is https. The dev server listens on port 8000 (see vite.config.ts).
ORIGIN=http://localhost:8000

# Port the production server (`pnpm start`) listens on.
PORT=8000

# Set to "production" to skip seeding the demo user so no known credential
# ships to a live deploy. Independent of NODE_ENV.
APP_ENV=development

# Secret for the app's OAuth2 client. The default is fine locally; it is
# REQUIRED when APP_ENV=production (the app refuses to start without it, since
# the fallback is public in the template source). Default: dev-only-secret
#OAUTH2_CLIENT_SECRET=dev-only-secret
