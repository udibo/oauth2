{
  "name": "oauth2-react-router-template",
  "version": "0.0.0",
  "private": true,
  "description": "A React Router framework-mode app on Hono with @udibo/oauth2 authentication preconfigured.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@react-router/node": "^8.4.0",
    "@udibo/oauth2": "workspace:*",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-router-hono-server": "^4.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@react-router/dev": "^8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.2"
  }
}
