# Copy to .env and adjust. Every variable has a safe local default — the app
# runs with no configuration at all.

# development | test | production. Controls demo-user seeding (skipped in
# production) and the session cookie's Secure flag (on in production).
APP_ENV=development
NODE_ENV=development

# OpenTelemetry: enable Deno's built-in instrumentation and name the service.
OTEL_DENO=true
OTEL_SERVICE_NAME=my-app

# The origin the app is served from. Used as the OAuth2 issuer and to build
# the redirect URI. Default: http://localhost:8000
#APP_ORIGIN=http://localhost:8000

# Secret for the app's OAuth2 client. The default is fine locally; it is
# REQUIRED when APP_ENV=production (the app refuses to start without it, since
# the fallback is public in the template source). Default: dev-only-secret
#OAUTH2_CLIENT_SECRET=dev-only-secret

# Address `deno task serve` listens on. Default: tcp:0.0.0.0:8000
#DENO_SERVE_ADDRESS=tcp:0.0.0.0:8000
