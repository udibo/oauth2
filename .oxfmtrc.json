{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "ignorePatterns": [
    "dist",
    "coverage",
    "pnpm-lock.yaml",
    "node_modules",
    "examples",
    "templates",
    "docs",
    "llms.txt",
    "llms-full.txt",
    "*.md",
    "scripts/doc-*.ts",
    "scripts/llms.ts",
    "scripts/prepare-*.ts",
    "scripts/public-suffix-list.ts",
    "scripts/verify-release*.ts",
    ".releaserc.json",
    ".github"
  ]
}
