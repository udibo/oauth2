{
  "links": ["../src"],
  "imports": {
    "@udibo/oauth2": "jsr:@udibo/oauth2@^0.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.0.9",
    "react": "npm:react@^19.0.0",
    "@types/react": "npm:@types/react@^19.2.17"
  },
  "tasks": {
    "check": {
      "description": "Type-checks the package's entrypoints the way an outside consumer resolves them.",
      "command": "deno check && deno lint && deno fmt --check"
    },
    "test": {
      "description": "Asserts the packaging invariants a bad publish would violate.",
      "command": "deno test -P=test"
    }
  },
  "permissions": {
    "test": {
      "read": true,
      "env": true,
      "net": true,
      "run": true,
      "write": true
    }
  },
  "test": {
    "sanitizeOps": true,
    "sanitizeResources": true
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  }
}
