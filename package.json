{
  "name": "@udibo/oauth2",
  "version": "0.15.0",
  "description": "A flexible OAuth2 toolkit: framework-agnostic authorization & resource servers, a typed client, Hono adapters (including a backend-for-frontend), and React bindings.",
  "keywords": [
    "authorization-server",
    "bff",
    "hono",
    "oauth2",
    "oidc",
    "openid-connect",
    "react",
    "resource-server"
  ],
  "homepage": "https://github.com/udibo/oauth2#readme",
  "bugs": {
    "url": "https://github.com/udibo/oauth2/issues"
  },
  "license": "MIT",
  "author": "Udibo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udibo/oauth2.git"
  },
  "bin": {
    "udibo-oauth2": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/mod.d.ts",
      "default": "./dist/server/mod.js"
    },
    "./server/authorization": {
      "types": "./dist/server/authorization-server.d.ts",
      "default": "./dist/server/authorization-server.js"
    },
    "./server/resource": {
      "types": "./dist/server/resource-server.d.ts",
      "default": "./dist/server/resource-server.js"
    },
    "./server/public-suffix": {
      "types": "./dist/server/public-suffix/mod.d.ts",
      "default": "./dist/server/public-suffix/mod.js"
    },
    "./client": {
      "types": "./dist/client/mod.d.ts",
      "default": "./dist/client/mod.js"
    },
    "./identity": {
      "types": "./dist/identity/mod.d.ts",
      "default": "./dist/identity/mod.js"
    },
    "./identity/external": {
      "types": "./dist/identity/external/mod.d.ts",
      "default": "./dist/identity/external/mod.js"
    },
    "./identity/mfa": {
      "types": "./dist/identity/mfa/mod.d.ts",
      "default": "./dist/identity/mfa/mod.js"
    },
    "./identity/migration": {
      "types": "./dist/identity/migration.d.ts",
      "default": "./dist/identity/migration.js"
    },
    "./hono/resource-server": {
      "types": "./dist/adapters/hono/resource-server.d.ts",
      "default": "./dist/adapters/hono/resource-server.js"
    },
    "./hono/authorization-server": {
      "types": "./dist/adapters/hono/authorization-server.d.ts",
      "default": "./dist/adapters/hono/authorization-server.js"
    },
    "./hono/bff": {
      "types": "./dist/adapters/hono/bff/mod.d.ts",
      "default": "./dist/adapters/hono/bff/mod.js"
    },
    "./hono/bff/testing": {
      "types": "./dist/adapters/hono/bff/testing.d.ts",
      "default": "./dist/adapters/hono/bff/testing.js"
    },
    "./hono/identity": {
      "types": "./dist/adapters/hono/identity.d.ts",
      "default": "./dist/adapters/hono/identity.js"
    },
    "./hono/log": {
      "types": "./dist/adapters/hono/log.d.ts",
      "default": "./dist/adapters/hono/log.js"
    },
    "./react": {
      "types": "./dist/react/mod.d.ts",
      "default": "./dist/react/mod.js"
    },
    "./react/components": {
      "types": "./dist/react/components/mod.d.ts",
      "default": "./dist/react/components/mod.js"
    },
    "./react/testing": {
      "types": "./dist/react/testing.d.ts",
      "default": "./dist/react/testing.js"
    },
    "./testing": {
      "types": "./dist/testing/mod.d.ts",
      "default": "./dist/testing/mod.js"
    },
    "./testing/contract": {
      "types": "./dist/testing/contract/mod.d.ts",
      "default": "./dist/testing/contract/mod.js"
    },
    "./crypto": {
      "types": "./dist/utils/crypto.d.ts",
      "default": "./dist/utils/crypto.js"
    },
    "./url": {
      "types": "./dist/utils/url.d.ts",
      "default": "./dist/utils/url.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm build && pnpm typecheck:examples && pnpm lint && pnpm fmt:check && tsc --noEmit && pnpm doc:lint && pnpm doc:check && pnpm doc:links && pnpm llms:check",
    "typecheck:examples": "pnpm -r --filter \"./examples/**\" --filter \"./templates/**\" typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "smoke": "node scripts/npm-smoke.ts",
    "jsr:dry-run": "jsr publish --dry-run --allow-dirty",
    "doc:lint": "node scripts/doc-lint.ts",
    "doc:check": "node scripts/doc-check.ts",
    "doc:links": "node scripts/doc-links.ts",
    "llms:generate": "node scripts/llms.ts",
    "llms:check": "node scripts/llms.ts --check",
    "psl:update": "node scripts/public-suffix-list.ts",
    "psl:check": "node scripts/public-suffix-list.ts --check",
    "release:verify": "node scripts/verify-release.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@udibo/http-error": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sebbo2002/semantic-release-jsr": "3.2.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "hono": "^4.13.13",
    "jsdom": "^30.1.2",
    "jsr": "^0.14.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "25.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}
