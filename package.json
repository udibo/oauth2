{
  "name": "@udibo/oauth2",
  "version": "0.14.1",
  "description": "A flexible OAuth2 toolkit: framework-agnostic authorization & resource servers, a typed client, Hono adapters (including a backend-for-frontend), and React bindings.",
  "keywords": [
    "authorization-server",
    "bff",
    "hono",
    "oauth2",
    "oidc",
    "openid-connect",
    "react",
    "resource-server"
  ],
  "homepage": "https://github.com/udibo/oauth2#readme",
  "bugs": {
    "url": "https://github.com/udibo/oauth2/issues"
  },
  "license": "MIT",
  "author": "Udibo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udibo/oauth2.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/mod.d.ts",
      "default": "./dist/server/mod.js"
    },
    "./server/authorization": {
      "types": "./dist/server/authorization-server.d.ts",
      "default": "./dist/server/authorization-server.js"
    },
    "./server/resource": {
      "types": "./dist/server/resource-server.d.ts",
      "default": "./dist/server/resource-server.js"
    },
    "./server/public-suffix": {
      "types": "./dist/server/public-suffix/mod.d.ts",
      "default": "./dist/server/public-suffix/mod.js"
    },
    "./client": {
      "types": "./dist/client/mod.d.ts",
      "default": "./dist/client/mod.js"
    },
    "./identity": {
      "types": "./dist/identity/mod.d.ts",
      "default": "./dist/identity/mod.js"
    },
    "./identity/external": {
      "types": "./dist/identity/external/mod.d.ts",
      "default": "./dist/identity/external/mod.js"
    },
    "./identity/mfa": {
      "types": "./dist/identity/mfa/mod.d.ts",
      "default": "./dist/identity/mfa/mod.js"
    },
    "./identity/migration": {
      "types": "./dist/identity/migration.d.ts",
      "default": "./dist/identity/migration.js"
    },
    "./hono/resource-server": {
      "types": "./dist/adapters/hono/resource-server.d.ts",
      "default": "./dist/adapters/hono/resource-server.js"
    },
    "./hono/authorization-server": {
      "types": "./dist/adapters/hono/authorization-server.d.ts",
      "default": "./dist/adapters/hono/authorization-server.js"
    },
    "./hono/bff": {
      "types": "./dist/adapters/hono/bff/mod.d.ts",
      "default": "./dist/adapters/hono/bff/mod.js"
    },
    "./hono/bff/testing": {
      "types": "./dist/adapters/hono/bff/testing.d.ts",
      "default": "./dist/adapters/hono/bff/testing.js"
    },
    "./hono/identity": {
      "types": "./dist/adapters/hono/identity.d.ts",
      "default": "./dist/adapters/hono/identity.js"
    },
    "./hono/log": {
      "types": "./dist/adapters/hono/log.d.ts",
      "default": "./dist/adapters/hono/log.js"
    },
    "./react": {
      "types": "./dist/react/mod.d.ts",
      "default": "./dist/react/mod.js"
    },
    "./react/components": {
      "types": "./dist/react/components/mod.d.ts",
      "default": "./dist/react/components/mod.js"
    },
    "./react/testing": {
      "types": "./dist/react/testing.d.ts",
      "default": "./dist/react/testing.js"
    },
    "./testing": {
      "types": "./dist/testing/mod.d.ts",
      "default": "./dist/testing/mod.js"
    },
    "./testing/contract": {
      "types": "./dist/testing/contract/mod.d.ts",
      "default": "./dist/testing/contract/mod.js"
    },
    "./crypto": {
      "types": "./dist/utils/crypto.d.ts",
      "default": "./dist/utils/crypto.js"
    },
    "./url": {
      "types": "./dist/utils/url.d.ts",
      "default": "./dist/utils/url.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm fmt:check && tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/npm-smoke.ts",
    "jsr:dry-run": "jsr publish --dry-run --allow-dirty"
  },
  "dependencies": {
    "@udibo/http-error": "npm:@jsr/udibo__http-error@^0.11.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "hono": "^4.13.13",
    "jsr": "^0.14.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}
